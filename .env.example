# Copy this to .env and fill in real values. Never commit .env.

# Microsoft Foundry: project jahbadh, deployment gpt-5-mini (portal > Models + endpoints > gpt-5-mini > Key)
FOUNDRY_OPENAI_BASE_URL=https://jahbadh-foundry.services.ai.azure.com/openai/v1/
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_REASONING_EFFORT=low

# Azure AI Translator, free tier F0 (portal > Translator resource > Keys and Endpoint)
TRANSLATOR_KEY=
TRANSLATOR_REGION=uaenorth
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Desk (the web API). Live mode calls the model and costs money, so it stays off unless set to on.
JAHBADH_LIVE_MODE=off
# Live actions a day across everyone (a fresh match and a spotlight each count as one)
JAHBADH_LIVE_PER_DAY=3
# Where the daily live counter is kept
JAHBADH_STATE_DIR=data/state
# Showcase matches for replay, and the built UI
JAHBADH_SHOWCASE_DIR=data/showcase
JAHBADH_WEB_DIST=web/dist
