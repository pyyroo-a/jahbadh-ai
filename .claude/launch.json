{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "jahbadh.api.app:create_app", "--factory", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-ingest",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-c", "import os, uvicorn; os.environ['JAHBADH_INGEST_TOKEN'] = 'local-demo-token'; uvicorn.run('jahbadh.api.app:create_app', factory=True, port=8000)"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
